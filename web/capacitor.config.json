{
  "appId": "com.vibebridge.mobile",
  "appName": "VibeBridge",
  "webDir": "dist",
  "server": { "androidScheme": "https", "iosScheme": "capacitor" },
  "android": { "allowMixedContent": false, "backgroundColor": "#0a0a0a" },
  "ios": { "backgroundColor": "#0a0a0a", "contentInset": "always", "limitsNavigationsToAppBoundDomains": false },
  "plugins": { "SplashScreen": { "launchShowDuration": 500, "backgroundColor": "#0a0a0a", "showSpinner": false } }
}
