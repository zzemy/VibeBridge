{
  "name": "vibebridge-web",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.5.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "proto:lint": "buf lint ../proto",
    "proto:generate": "buf generate ../proto --template ../buf.gen.yaml --output ..",
    "proto:breaking": "buf breaking ../proto --against ../.git#branch=origin/main,subdir=proto",
    "test:e2e:pairing": "pnpm build && playwright test e2e/pairing.spec.ts"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.72.0",
    "@playwright/test": "1.62.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "fake-indexeddb": "6.2.5",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.13.0",
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "noise-handshake": "4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sodium-javascript": "0.8.0",
    "tailwind-merge": "^3.6.0"
  }
}
